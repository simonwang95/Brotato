{
  "name": "brotato-number-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "test": "node tests/calculator.test.mjs && node tests/strategyGenerator.test.mjs && node tests/scenarioCalculator.test.mjs && node tests/officialCatalog.test.mjs && node tests/officialLocalization.test.mjs && node tests/strategyCatalog.test.mjs && node tests/compendium.test.mjs && node tests/unlockAudit.test.mjs && node tests/pendingUnlocks.test.mjs && node tests/optimizedTranslation.test.mjs",
    "extract:catalog": "node scripts/extract-official-catalog.mjs --write && node scripts/extract-official-assets.mjs",
    "extract:assets": "node scripts/extract-official-assets.mjs",
    "extract:localization": "node scripts/extract-official-localization.mjs --write",
    "extract:unlocks": "node scripts/extract-official-unlocks.mjs --write",
    "unlocks:pending": "node scripts/report-unlock-pending.mjs --write",
    "verify:catalog": "node scripts/verify-strategy-catalog.mjs",
    "verify:unlocks": "node scripts/verify-unlocks.mjs",
    "verify:names": "node scripts/verify-official-names.mjs",
    "localization:coverage": "node scripts/report-localization-coverage.mjs",
    "start": "node scripts/dev-server.mjs",
    "start:static": "python3 -m http.server 5174"
  }
}
